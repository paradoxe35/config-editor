    "6_deeply_nested_combinations": {
      "type": "object",
      "properties": {
        "matrix_of_objects": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["x", "y"],
              "properties": {
