{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Schema help",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "cloudflare": {
      "title": "Cloudflare",
      "description": "Records in a Cloudflare zone.",
      "type": "object",
      "required": ["cloudflare"],
      "properties": {
        "cloudflare": {
          "type": "object",
          "description": "The zone and its token.",
          "properties": { "api_token": { "type": "string" }, "zone": { "type": "string" } }
        },
        "ttl": { "type": "integer", "description": "Seconds records are cached." }
      }
    }
  },
  "properties": {
    "dns": {
      "description": "Where the DNS records are managed.",
      "oneOf": [
        { "$ref": "#/$defs/cloudflare" },
        {
          "title": "Route 53",
          "description": "Records in an AWS hosted zone.",
          "type": "object",
          "required": ["route53"],
          "properties": {
            "route53": { "type": "object", "properties": { "zone_id": { "type": "string" } } },
            "ttl": { "type": "integer", "description": "Seconds records are cached." }
          }
        },
        {
          "title": "Manual",
          "description": "Records kept by hand.",
          "type": "object",
          "required": ["provider"],
          "properties": {
            "provider": { "const": "manual" },
            "records": { "type": "array", "items": { "type": "string" } }
          }
        },
        {
          "title": "Static file",
          "description": "Records read from a file.",
          "type": "object",
          "required": ["provider"],
          "properties": { "provider": { "const": "static" }, "path": { "type": "string" } }
        }
      ]
    },
    "mode": {
      "description": "How requests are routed.",
      "x-docs-url": "https://example.com/docs/mode",
      "enum": ["fast", "safe", "debug"],
      "x-enum-descriptions": ["Skips the checks.", "Checks everything.", "Logs every step."]
    },
    "level": {
      "description": "How much to log.",
      "oneOf": [
        { "const": "info", "title": "Info", "description": "Normal messages." },
        { "const": "trace", "title": "Trace", "description": "Everything, very verbose." }
      ]
    },
    "timeout": {
      "type": "integer",
      "description": "Seconds before giving up.",
      "deprecated": true,
      "deprecationMessage": "Use deadline instead."
    },
    "deadline": {
      "type": "integer",
      "description": "Seconds before giving up."
    },
    "server": {
      "type": "object",
      "description": "The upstream server.",
      "additionalProperties": false,
      "required": ["host", "port", "scheme"],
      "properties": {
        "host": { "type": "string", "description": "Host name." },
        "port": { "type": "integer", "examples": [8080] },
        "scheme": { "type": "string", "default": "https" }
      }
    },
    "bind": {
      "description": "A port, or ip:port.",
      "type": ["integer", "string"],
      "examples": ["0.0.0.0:7835"]
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bind"],
      "properties": { "bind": { "$ref": "#/properties/bind" } }
    },
    "env": {
      "type": "object",
      "description": "Environment variables.",
      "patternProperties": {
        "^[A-Z_]+$": { "type": "string", "description": "One variable." }
      }
    },
    "labels": {
      "type": "object",
      "patternProperties": {
        "^(?!x-)[a-z]+$": { "type": "string" }
      }
    }
  }
}
