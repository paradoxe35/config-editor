{
  "name": "@pngwasi/config-editor",
  "version": "0.1.0",
  "description": "Schema-aware config editor for YAML, JSON, TOML, HCL and XML in the browser (Rust/WebAssembly)",
  "type": "module",
  "main": "pkg/config_editor.js",
  "module": "pkg/config_editor.js",
  "types": "pkg/config_editor.d.ts",
  "exports": {
    ".": {
      "types": "./pkg/config_editor.d.ts",
      "default": "./pkg/config_editor.js"
    },
    "./config_editor_bg.wasm": "./pkg/config_editor_bg.wasm"
  },
  "files": [
    "pkg/config_editor.js",
    "pkg/config_editor.d.ts",
    "pkg/config_editor_bg.wasm",
    "pkg/config_editor_bg.wasm.d.ts",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node build.mjs"
  },
  "keywords": [
    "config",
    "editor",
    "yaml",
    "json",
    "toml",
    "hcl",
    "xml",
    "json-schema",
    "wasm"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paradoxe35/laptos-yaml-editor.git",
    "directory": "js/config-editor"
  },
  "homepage": "https://github.com/paradoxe35/laptos-yaml-editor#readme",
  "bugs": {
    "url": "https://github.com/paradoxe35/laptos-yaml-editor/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
